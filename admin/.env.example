# ── Supabase ──────────────────────────────────────────────────────────────
# Públicas (se exponen al navegador): URL del proyecto + anon key.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# SECRETA — solo servidor. NUNCA usar el prefijo NEXT_PUBLIC_ con esta clave.
# Se usa para crear usuarios desde el panel (admin). Mantener fuera del cliente.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ── Seguridad / despliegue ──────────────────────────────────────────────────
# Orígenes de confianza para Server Actions (anti-CSRF). Coma-separados, sin
# protocolo. Ej: midominio.com,www.midominio.com
ALLOWED_ORIGINS=

# ── Contacto ────────────────────────────────────────────────────────────────
# WhatsApp del negocio (formato internacional sin signos) para el formulario
# de contacto de la landing. Ej: 595971000000
NEXT_PUBLIC_WHATSAPP=595000000000

# ── Cron Jobs / Automatizaciones ─────────────────────────────────────────────
# Clave secreta que Vercel envía en el header Authorization: Bearer <secret>
# para autenticar los cron jobs. Generá uno con: openssl rand -hex 32
# Agregalo también en Vercel → Settings → Environment Variables.
CRON_SECRET=tu-cron-secret-aqui
# Notion API key (https://www.notion.so/profile/integrations)
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase service-role key para los cron jobs (acceso sin RLS)
# Podés reusar SUPABASE_SERVICE_ROLE_KEY o crear uno aparte
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-service-role-key

# Gmail SMTP — usá una "Contraseña de aplicación" (App Password), NO tu contraseña normal.
# Generala en: myaccount.google.com/apppasswords (requiere 2FA activo)
GMAIL_USER=tu-email@gmail.com
GMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Email donde llegan los recordatorios diarios y los posts de Facebook
RECIPIENT_EMAIL=tu-email@gmail.com
